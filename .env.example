# --- Public (safe for the browser) -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Either key works; the publishable key is preferred when present.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Country used when a phone number is typed without +country code (ISO code, e.g. SA, AE, KW, EG).
NEXT_PUBLIC_DEFAULT_PHONE_COUNTRY=SA

# --- Server only (never prefix with NEXT_PUBLIC_) ------------------------------
SUPABASE_SERVICE_ROLE_KEY=
# Use Supabase -> Connect -> Session pooler (IPv4-friendly). URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Random 32+ chars. Vercel Cron sends "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=
# Random 32+ chars, used to HMAC OTP codes.
OTP_PEPPER=
# Show the mock OTP on the verify screen. Always on outside production; set to true for a hosted demo.
DEMO_OTP_DISPLAY=false

# --- WhatsApp (server only). See docs/whatsapp.md --------------------------------
# Leave all empty for demo mode (codes shown on screen, reminders sent by staff with one tap).
# FREE mode: patients send their code to the clinic number. Needs these three:
WHATSAPP_CLINIC_NUMBER=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# PAID mode: also set these and WHATSAPP_AUTO_SEND=true. Codes and reminders are then sent automatically (billed by Meta).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_AUTO_SEND=false
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_TEMPLATE_OTP=mosa3da_otp
WHATSAPP_TEMPLATE_APPOINTMENT=mosa3da_appointment_reminder
WHATSAPP_TEMPLATE_TURN=mosa3da_turn_approaching

# --- Demo seed (scripts/seed-demo.ts) ------------------------------------------
DEMO_DOCTOR_EMAIL=doctor@mosa3da.app
DEMO_DOCTOR_PASSWORD=
DEMO_SECRETARY_EMAIL=secretary@mosa3da.app
DEMO_SECRETARY_PASSWORD=
DEMO_PATIENT_PASSWORD=

# --- Tests ---------------------------------------------------------------------
# Disposable database with migrations applied. NEVER point this at production.
TEST_DATABASE_URL=
